# Port the server listens on
PORT=3000

# --- Admin panel ---
# Username used to log into /admin
ADMIN_USERNAME=admin

# Never put a plaintext password here. Generate a bcrypt hash with:
#   npm run hash-password -- "YourStrongPasswordHere"
# then paste the resulting hash below.
ADMIN_PASSWORD_HASH=$2a$12$DerhJLWJCWSWnYtsk9gVRe2T6fRMM3qQKlaZxtISgUAKdUnNJBsyC

# Long random string used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to "true" once the site is served over HTTPS in production —
# this marks the session cookie as Secure (HTTPS-only).
SESSION_SECURE=false

# --- Optional: email notifications for new intake submissions ---
# Leave these blank to skip email and just store submissions in data/submissions.json.
# If you fill these in (and wire up routes/intake.js as described in the README),
# you can notify the team by email whenever someone submits a problem.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
